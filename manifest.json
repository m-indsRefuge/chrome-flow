{
  "manifest_version": 3,
  "minimum_chrome_version": "114",
  "name": "Constellation",
  "version": "0.1.0",
  "description": "A local-first browser cognitive workspace for research, organisation, recovery, and durable workspace memory.",
  "permissions": [
    "tabs",
    "storage",
    "sidePanel",
    "windows",
    "tabGroups"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "src/sidepanel/sidepanel.html"
  },
  "options_ui": {
    "page": "src/migration/migration.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "Open Constellation"
  }
}
