{
  "name": "constellation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "npm run test:characterization && npm run test:runtime-contract && npm run test:runtime-session-authority && npm run test:journal-coordination && npm run test:reconciliation-coordination && npm run test:workspace-resolution && npm run test:workspace-resolution-coordination && npm run test:workspace-creation-assignment-transaction && npm run test:workspace-library-resume-gate && npm run test:workspace-existing-tab-move-engine && npm run test:workspace-automatic-promotion-transaction",
    "test:characterization": "node --test --test-isolation=none tests/characterization/*.test.js",
    "test:runtime-contract": "node --test --test-isolation=none tests/runtime-contract/*.test.js",
    "test:runtime-session-authority": "node --test --test-isolation=none tests/runtime-session-authority/*.test.js",
    "test:journal-coordination": "node --test --test-isolation=none tests/journal-append-coordination/*.test.js",
    "test:reconciliation-coordination": "node --test --test-isolation=none tests/workspace-projection-reconciliation/*.test.js",
    "test:workspace-resolution": "node --test --test-isolation=none tests/workspace-resolution/*.test.js",
    "test:workspace-resolution-coordination": "node --test --test-isolation=none tests/workspace-resolution-coordination/*.test.js",
    "test:workspace-creation-assignment-transaction": "node --test --test-isolation=none tests/workspace-creation-assignment-transaction/*.test.js",
    "validate:workspace-creation-assignment-transaction": "node scripts/run-workspace-creation-assignment-transaction-validation.mjs",
    "test:workspace-library-resume-gate": "node --test --test-isolation=none tests/workspace-library-resume-gate/*.test.js",
    "validate:workspace-library-resume-gate": "node scripts/run-workspace-library-resume-gate-validation.mjs",
    "test:workspace-existing-tab-move-engine": "node --test --test-isolation=none tests/workspace-existing-tab-move-engine/*.test.js",
    "validate:workspace-existing-tab-move-engine": "node scripts/run-workspace-existing-tab-move-engine-validation.mjs",
    "test:workspace-automatic-promotion-transaction": "node --test --test-isolation=none tests/workspace-automatic-promotion-transaction/*.test.js",
    "validate:workspace-automatic-promotion-transaction": "node scripts/run-workspace-automatic-promotion-transaction-validation.mjs",
    "check:inventory": "node scripts/check-runtime-inventory.mjs",
    "check:runtime-contract-purity": "node scripts/check-runtime-contract-purity.mjs",
    "check": "npm run check:inventory && npm run check:runtime-contract-purity && npm test"
  }
}
